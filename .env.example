APP_NAME="CheckIn WA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
NGINX_PORT=8080

# PostgreSQL (Docker service: postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=checkin_wa
DB_USERNAME=checkin
DB_PASSWORD=change_me_local_only

# Redis (Docker service: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# WhatsApp Cloud API (Meta) - Nunca colocar secretos reales aquí
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Asistencia & Geolocalización
ATTENDANCE_LOCATION_TTL_SECONDS=120
ATTENDANCE_OTP_TTL_SECONDS=600
ATTENDANCE_OTP_MAX_ATTEMPTS=5
